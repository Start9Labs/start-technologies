#!/bin/sh
# Re-evaluate remote access firewall rules when WAN interface changes.
[ "$ACTION" = "ifup" -o "$ACTION" = "ifupdate" -o "$ACTION" = "ifdown" ] && [ "$INTERFACE" = "wan" -o "$INTERFACE" = "wan6" -o "$INTERFACE" = "wwan" ] && {
    /usr/bin/startwrt-cli system apply-remote-access 2>/dev/null &
}

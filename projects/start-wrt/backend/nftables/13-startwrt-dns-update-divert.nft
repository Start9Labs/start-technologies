# Diverts DNS UPDATE packets and every DNS-over-TCP connection addressed to
# a profile gateway to the daemon's per-profile listeners. UDP queries stay
# with dnsmasq; the daemon relays TCP queries to it.
#
# `@th,81,4` is the DNS opcode (UDP header 64 bits, flags at bit 80); 5 is
# UPDATE. A TCP SYN carries no opcode; TCP is diverted whole.
# A profile arrival matches only an address on its own bridge interface,
# leaving the WAN address to published ports and their reflection.
# An inbound WireGuard arrival matches any router address: its clients'
# resolver is the profile gateway, on the bridge. It takes its own port.
# `redirect` delivers to the arriving interface's primary address: the
# gateway on a profile, the server address on `wg_*`. Priority -101 runs
# ahead of fw4's dstnat (-100), including the per-profile DNS-Override DNAT.
#
# `redirect` needs kmod-nft-nat (build/openwrt.diffconfig); without it fw4
# loads no ruleset at all.
chain startwrt_dns_update_divert {
	type nat hook prerouting priority -101; policy accept;
	iifname "wg_*" meta nfproto ipv4 fib daddr type local udp dport 53 @th,81,4 == 5 limit rate 20/second burst 50 packets counter redirect to :9554
	iifname "br-lan*" meta nfproto ipv4 fib daddr . iif type local udp dport 53 @th,81,4 == 5 limit rate 20/second burst 50 packets counter redirect to :9553
	iifname "wg_*" meta nfproto ipv4 fib daddr type local tcp dport 53 counter redirect to :9554
	iifname "br-lan*" meta nfproto ipv4 fib daddr . iif type local tcp dport 53 counter redirect to :9553
}

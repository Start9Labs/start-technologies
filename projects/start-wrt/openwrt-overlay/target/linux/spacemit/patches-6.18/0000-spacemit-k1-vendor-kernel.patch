+int cts_tcs_write_hw_reg(struct cts_device *cts_dev, u32 addr,
+        u8 *regbuf, size_t size)
+{
+    u8 *buf;
+    int ret;
+
+    buf = kmalloc(size + 6, GFP_KERNEL);
+    if (buf == NULL)
+        return -ENOMEM;
+
+    buf[0] = ((size >> 0) & 0xFF);
+    buf[1] = ((size >> 8) & 0xFF);
+    buf[2] = ((addr >> 0) & 0xFF);
+    buf[3] = ((addr >> 8) & 0xFF);
+    buf[4] = ((addr >> 16) & 0xFF);
+    buf[5] = 0x00;
+    memcpy(buf + 6, regbuf, size);
+
+    ret = cts_tcs_write(cts_dev, CMD_TP_DATA_WR_REG_RAM_SEQUENCE_WO,
+            buf, size + 6);
+    if (ret != 0) {
+        kfree(buf);
+        return ret;
+    }
+
+    kfree(buf);
+
+    return ret;
+}

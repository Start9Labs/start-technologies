+static int __check_wefuse_parameter(struct __wefuse *par)
+{
+	if (par->mac_address)
+		if (!par->device && !par->file_path)
+			return 1;
+
+	if (!par->led0 ^ !par->led1)
+		return 1;
+
+	return 0;
+}

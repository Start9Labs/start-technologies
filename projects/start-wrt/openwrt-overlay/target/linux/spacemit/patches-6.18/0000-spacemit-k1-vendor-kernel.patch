+            buf + count, PAGE_SIZE - count, true);
+        count += strlen(buf + count);
+
+        if (count < PAGE_SIZE) {
+            buf[count++] = '\n';
+            addr += PRINT_ROW_SIZE;
+        } else {
+            break;
+        }
+    }
+
+err_free_data:
+    cts_unlock_device(cts_dev);
+    kfree(data);
+
+    return count;
+#undef PRINT_ROW_SIZE
+}

+static struct dw_pcie_ep_ops pcie_ep_ops = {
+	.init = k1x_pcie_ep_init,
+	.raise_irq = k1x_pcie_raise_irq,
+	//.enable_irq = k1x_pcie_ep_enable_irq,
+	//.disable_irq = k1x_pcie_ep_disable_irq,
+	.get_features = k1x_pcie_get_features,
+};

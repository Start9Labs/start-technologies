+
+	ret = copy_to_user((void __user *)info->flash.buf, buf, 20);
+	if (ret) {
+		netdev_err(axdev->netdev,
+			   "copy_to_user efuse offset: 0x%x failed", offset);
+		return ret;
+	}
+
+	return ret;
+}

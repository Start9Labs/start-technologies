+    .llseek  = seq_lseek,
+    .release = seq_release,
+};
+#else
+static const struct proc_ops selftest_proc_fops = {
+    .proc_open    = selftest_proc_open,
+    .proc_read    = seq_read,
+    .proc_lseek   = seq_lseek,
+    .proc_release = seq_release,
+};
+#endif

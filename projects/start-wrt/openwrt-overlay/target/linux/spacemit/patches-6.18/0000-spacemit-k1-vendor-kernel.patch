-	storage->collisions += tx_stats->stats.tx_excessclsn_pkts;
-
-	storage->rx_missed_errors = rx_stats->stats.rx_drp_fifo_full_pkts;
-	storage->rx_missed_errors += rx_stats->stats.rx_truncate_fifo_full_pkts;

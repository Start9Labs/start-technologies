+    .ndo_tx_timeout        = usbnet_tx_timeout,
+    .ndo_change_mtu        = usbnet_change_mtu,
+    .ndo_get_stats64    = qmi_wwan_get_stats64,
+    .ndo_set_mac_address    = qmi_wwan_mac_addr,

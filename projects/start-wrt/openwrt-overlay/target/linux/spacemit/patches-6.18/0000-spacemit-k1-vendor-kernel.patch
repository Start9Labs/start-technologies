+	if (cclk_cur_frequency < jdev->cclk_min_frequency
+	    || cclk_cur_frequency > jdev->cclk_max_frequency) {
+		return -EINVAL;
+	}
+
+	jdev->cclk_cur_frequency = cclk_cur_frequency;
+
+	return count;
+}

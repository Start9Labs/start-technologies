+#define CTS_TEST_FLAG_RESET_BEFORE_TEST             (1u << 0)
+#define CTS_TEST_FLAG_RESET_AFTER_TEST              (1u << 1)
+#define CTS_TEST_FLAG_DISPLAY_ON                    (1u << 2)
+#define CTS_TEST_FLAG_DISABLE_GAS                   (1u << 3)

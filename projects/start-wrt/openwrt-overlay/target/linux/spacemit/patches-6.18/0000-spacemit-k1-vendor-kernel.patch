+static int ax88179a_set_phy_power(struct ax_device *axdev, bool on)
+{
+	u8 reg8;
+	int ret;
+
+	reg8 = (on)?AX_PHY_POWER:0;
+	ret = ax_write_cmd_nopm(axdev, AX88179A_PHY_POWER, 0, 0, 1, &reg8);

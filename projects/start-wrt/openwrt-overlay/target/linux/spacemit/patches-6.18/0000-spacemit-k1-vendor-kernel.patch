+static void checksum_efuse_block(unsigned char *block)
+{
+	unsigned int Sum = 0;
+	int j;
+
+	DEBUG_PRINT("=== %s - Start\n", __func__);
+
+	for (j = 0; j < 4; j++) {
+		if (j == 0)
+			Sum += block[j] & 0xF;
+		else
+			Sum += block[j];
+	}
+
+	while (Sum > 0xF)
+		Sum = (Sum & 0xF) + (Sum >> 4);
+
+	Sum = 0xF - Sum;
+
+	block[0] = (block[0] & 0xF) | ((Sum << 4) & 0xF0);
+}
+
+static void checksum_para_header(unsigned short *header)
+{
+	unsigned int Sum = 0;
+	unsigned short j;
+
+	DEBUG_PRINT("=== %s - Start\n", __func__);
+
+	for (j = 0; j < 5; j++)
+		Sum += header[j];
+
+	while (Sum > 0xFFFF)
+		Sum = (Sum & 0xFFFF) + (Sum >> 16);
+
+	Sum = 0xFFFF - Sum;
+
+	header[5] = (Sum);
+}

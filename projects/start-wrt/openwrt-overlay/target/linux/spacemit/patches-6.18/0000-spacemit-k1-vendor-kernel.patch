+	DEBUG_PRINTK("%s - Start offset: %d (0x%x)", __func__, offset, offset);
+
+	ret = ax_read_cmd(axdev, AX_ACCESS_EFUSE, offset, 0, 20, buf, 0);
+	if (ret < 0) {

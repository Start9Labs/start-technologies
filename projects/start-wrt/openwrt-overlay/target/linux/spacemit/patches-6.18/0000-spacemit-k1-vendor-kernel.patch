+	ret = drm_connector_init(drm, connector,
+				&spacemit_dsi_atomic_connector_funcs,
+				DRM_MODE_CONNECTOR_DSI);
+	if (ret) {
+		DRM_ERROR("drm_connector_init() failed\n");

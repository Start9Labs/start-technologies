+static int find_offest_min_index(int *offset_arr, int size)
+{
+	int i = 0;
+	int min = offset_arr[0];
+
+	for (i = 1; i < size; i++) {
+        if (offset_arr[i] < min) {
+            min = offset_arr[i];
+        }
+    }
+
+	return min;
+}
+
+static int find_offest_max_index(int *offset_arr, int size)
+{
+	int i = 0;
+	int max = offset_arr[0];
+
+	for (i = 1; i < size; i++) {
+		if (offset_arr[i] >= max) {
+				max = i;
+		}
+	}
+
+	return max;
+}

+	mboxes = <&mailbox 0>, <&mailbox 1>;
+	mbox-names = "vq0", "vq1";
+	memory-region = <&rcpu_mem_0>, <&vdev0vring0>, <&vdev0vring1>, <&vdev0buffer>, <&rsc_table>, <&rcpu_mem_snapshots>;
+	status = "okay";
+};
diff --git a/arch/riscv/boot/dts/spacemit/x1_orangepi-rv2.dts b/arch/riscv/boot/dts/spacemit/x1_orangepi-rv2.dts

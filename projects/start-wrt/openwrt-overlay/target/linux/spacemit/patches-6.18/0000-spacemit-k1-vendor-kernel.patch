+#define	INTB						BIT(7)
+#define	INTC						BIT(8)
+#define	INTD						BIT(9)
+#define	LEG_EP_INTERRUPTS (INTA | INTB | INTC | INTD)
+#define INTX_MASK				GENMASK(9, 6)
+#define INTX_SHIFT					6
+
+#define	K1X_PHY_AHB_IRQENABLE_SET_INTX  0x000c
+
+#define	K1X_PHY_AHB_IRQSTATUS_MSI   0x0010
+#define	MSI						BIT(11)

+        return ret;
+    }
+
+    cmd_recv = get_unaligned_le16(rx + rxlen - 4);
+    cmd_send = get_unaligned_le16(tx + 1);
+    if (cmd_recv != cmd_send) {
+        cts_dbg("cmd check error, send %04x != %04x recv", cmd_send, cmd_recv);

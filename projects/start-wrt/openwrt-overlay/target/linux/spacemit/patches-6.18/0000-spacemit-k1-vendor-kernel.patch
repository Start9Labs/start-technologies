+                if (oem_data->type##_test_data == NULL) { \
+                    cts_err("Alloc " #type " test data mem failed"); \
+                    return -ENOMEM; \
+                } \
+                oem_data->type##_test_data_buff_size = size; \
+            } \
+            memset(oem_data->type##_test_data, 0, size); \
+        } \
+    } while (0)

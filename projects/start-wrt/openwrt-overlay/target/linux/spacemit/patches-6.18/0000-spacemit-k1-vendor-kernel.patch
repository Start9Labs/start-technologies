+} RMNET_INFO;
+
+typedef struct sQmiWwanQmap
+{
+    struct usbnet *mpNetDev;
+    struct driver_info driver_info;
+    atomic_t refcount;
+    struct net_device *mpQmapNetDev[FIBOCOM_WWAN_QMAP];

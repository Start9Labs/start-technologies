+
+		mac_address0: mac_address0@0 {
+			reg = <0x0 6>;
+		};
+
+		mac_address1: mac_address1@6 {
+			reg = <0x6 6>;
+		};
+	};
+
+        es8156_audio_codec: es8156@8 {
+                #sound-dai-cells = <0>;
+                compatible = "everest,es8156";
+                reg = <0x08>;
+                sound-name-prefix = "ES8156";
+		status = "okay";
+              //AVDD-supply = <&soc_aud_3v3_en_reg>;
+              //DVDD-supply = <&soc_aud_1v8_en_reg>;
+              //PVDD-supply = <&soc_aud_1v8_en_reg>;
+        };
+
+        es7210_audio_codec: es7210@40 {
+                #sound-dai-cells = <0>;
+                compatible = "MicArray_0";
+                reg = <0x40>;
+                sound-name-prefix = "ES7210";
+		status = "okay";
+              //MVDD-supply = <&soc_aud_3v3_en_reg>;
+              //AVDD-supply = <&soc_aud_3v3_en_reg>;
+              //DVDD-supply = <&soc_aud_1v8_en_reg>;
+              //PVDD-supply = <&soc_aud_1v8_en_reg>;
+        };
+
+	es8326: es8326@19{
+		compatible = "everest,es8326";
+		reg = <0x19>;
+		#sound-dai-cells = <0>;
+		interrupt-parent = <&gpio>;
+		interrupts = <126 1>;
+		spk-ctl-gpio = <&gpio 127 0>;
+		everest,mic1-src = [44];
+		everest,mic2-src = [66];
+		status = "okay";
+	};
+};
+
+&i2c3 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_i2c3_2>;
+	status = "disabled";
+};
+
+&i2c4 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_i2c4_2>;
+	status = "disabled";
+};
+
+&i2c5 {
+        pinctrl-names = "default";
+        pinctrl-0 = <&pinctrl_i2c5_0>;
+        spacemit,i2c-fast-mode;
+	status = "okay";
+
+        ioexp1: gpio@18 {
+                compatible = "nxp,pca9557";
+                reg = <0x18>;
+                gpio-controller;
+                #gpio-cells = <2>;
+                gpio-line-names = "",
+                                  "cam3_reset",
+                                  "cam0_reset",
+                                  "",
+                                  "wl_host_wake",
+                                  "bt_resetn",
+                                  "",
+                                  "bt_host_wake";
+        };
+};
+
+&i2c6 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_i2c6_0>;
+	status = "okay";
+
+	touch@14 {
+		compatible = "goodix,gt9271";
+		reg = <0x14>;
+
+		reset-gpios = <&ioexp2 0 GPIO_ACTIVE_HIGH>;
+		irq-gpios = <&gpio 74 GPIO_ACTIVE_HIGH>;
+		irq-flags = <2>;
+		interrupt-parent = <&gpio>;
+		interrupts = <74 2>;

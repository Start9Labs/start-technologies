+static bool sgm4154x_is_volatile_reg(struct device *dev, unsigned int reg)
+{
+	switch (reg) {
+	case SGM4154x_CHRG_CTRL_0...SGM4154x_CHRG_CTRL_f:
+		return true;
+	default:
+		return false;
+	}
+}

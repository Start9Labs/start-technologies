+int cts_plat_reset_device(struct cts_platform_data *pdata)
+{
+    /* !!!can not be modified */
+    /* !!!can not be modified */
+    /* !!!can not be modified */
+    cts_plat_set_reset(pdata, 1);
+    mdelay(1);
+    cts_plat_set_reset(pdata, 0);
+    mdelay(5);/* 1ms */
+    cts_plat_set_reset(pdata, 1);
+    /* under normal mode, delay over 50ms */
+#ifdef CONFIG_CTS_I2C_HOST
+    mdelay(160);
+#else
+    mdelay(70);
+#endif
+    return 0;
+}

+
+	jpu_cclk_disable(jdev);
+	jpu_aclk_disable(jdev);
+	jpu_iclk_disable(jdev);
+	jpu_jpg_reset_assert(jdev);
+	jpu_lcd_mclk_reset_assert(jdev);
+	jpu_isp_ci_reset_assert(jdev);
+	jpu_freset_assert(jdev);
+	jpu_sreset_assert(jdev);
+
+	return 0;
+}
+#endif

+static ssize_t wdt_debug_show(struct device *dev, struct device_attribute *attr,
+			     char *buf)
+{
+	int s = 0;
+
+	s += sprintf(buf, "wdt irq count: %d\n", wdt_irq_count);
+	return s;
+}

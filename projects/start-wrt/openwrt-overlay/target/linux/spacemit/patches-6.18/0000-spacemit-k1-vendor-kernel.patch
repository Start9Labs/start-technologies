+				   (unsigned int *)&argument.LED1[0],
+				   (unsigned int *)&argument.LED1[1],
+				   (unsigned int *)&argument.LED1[2],
+				   (unsigned int *)&argument.LED1[3]);
+			break;
+		case '?':
+		default:
+			return -FAIL_INVALID_PARAMETER;
+		}
+	}
+
+	ret = scan_ax_device(ifr, info->inet_sock);
+	if (ret < 0) {

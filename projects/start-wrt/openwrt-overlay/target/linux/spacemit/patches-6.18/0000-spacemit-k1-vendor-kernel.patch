+	dw_pcie_writew_dbi(pci, PCI_VENDOR_ID, K1X_PCIE_VENDOR_ID);
+	dw_pcie_writew_dbi(pci, PCI_DEVICE_ID, k1X_PCIE_DEVICE_ID);
+	dw_pcie_dbi_ro_wr_dis(pci);

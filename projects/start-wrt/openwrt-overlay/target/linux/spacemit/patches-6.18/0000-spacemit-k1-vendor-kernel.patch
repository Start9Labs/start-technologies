+#define	PCIE_RC_PERST					BIT(12)
+/* Wake# GPIO in EP mode 1: Wake# low, 0: Wake# high */
+#define	PCIE_EP_WAKE					BIT(13)
+#define	APP_HOLD_PHY_RST				BIT(30)
+/* BIT31 0: EP, 1: RC*/
+#define	DEVICE_TYPE_RC					BIT(31)
+
+#define	PCIE_CTRL_LOGIC					0x0004

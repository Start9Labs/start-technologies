+typedef union {
+    struct {
+        unsigned int bbox_start            : 16;      /**< v2d fbc encoder bbox start */
+        unsigned int bbox_end              : 16;      /**< v2d fbc encoder bbox end */
+    } field;                                            /**< Fields view */

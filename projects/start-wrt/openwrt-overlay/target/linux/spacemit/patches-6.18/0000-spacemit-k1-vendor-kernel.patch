+static bool ax88179a_check_phy_power(struct ax_device *axdev)
+{
+	u8 reg8 = 0;
+	int ret = 0;
+
+	ret = ax_read_cmd_nopm(axdev, AX88179A_PHY_POWER, 0, 0, 1, &reg8, 1);
+	if (ret < 0)
+		return false;
+
+	return (reg8 & AX_PHY_POWER);

+    int normal_rawdata_min;
+    int normal_rawdata_max;
+    int normal_noise_frames;
+    int normal_noise_max;
+    int normal_open_min;
+    int normal_short_min;
+    int normal_compcap_min;
+    int normal_compcap_max;
+

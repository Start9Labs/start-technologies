+
+#define ADDR_MSI_RECV_CTRL 				0x0080
+#define MSI_MON_EN 					BIT(0)
+#define MSIX_MON_EN 					GENMASK(8, 1)
+#define MSIX_AFIFO_FULL 				BIT(30)
+#define MSIX_AFIFO_EMPTY 				BIT(29)
+#define ADDR_MSI_RECV_ADDR0 				0x0084

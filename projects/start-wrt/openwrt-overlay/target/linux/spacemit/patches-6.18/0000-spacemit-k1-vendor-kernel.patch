+    if (cts_dev->rtdata.program_mode)
+        return cts_dev_writew(cts_dev, addr, w, retry, delay);
+    else {
+        put_unaligned_le16(w, buff);
+
+        return cts_write_sram_normal_mode(cts_dev, addr, buff, 2, retry, delay);
+    }
+}

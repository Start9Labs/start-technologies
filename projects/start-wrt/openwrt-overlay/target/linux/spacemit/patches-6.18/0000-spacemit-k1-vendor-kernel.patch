+#define	EDMA_INT1					BIT(1)
+#define	EDMA_INT2					BIT(2)
+#define	EDMA_INT3					BIT(3)
+#define	EDMA_INT4					BIT(4)
+#define	EDMA_INT5					BIT(5)

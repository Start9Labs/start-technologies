+			default-state = "on";
+			status = "okay";
+		};
+
+		led2 {
+			label = "ssd-led";
+			gpios = <&gpio 92 0>;
+			linux,default-trigger = "disk-activity";
+			status = "okay";
+		};
+	};
+
+	fan: pwm-fan {
+		compatible = "pwm-fan";
+		pwms = <&rpwm2 10000>;
+		#cooling-cells = <2>;
+		cooling-levels = <0 64 128 192 255>;
+		status = "okay";
+	};
+};
+
+&uart0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_uart0_2>;
+	status = "okay";

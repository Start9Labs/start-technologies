+static bool is_invalid_node(u32 *invalid_nodes, u32 num_invalid_nodes,
+    u16 row, u16 col)
+{
+    int i;
+
+    for (i = 0; i < num_invalid_nodes; i++) {
+        if (MAKE_INVALID_NODE(row, col) == invalid_nodes[i]) {
+            return true;
+        }
+    }
+
+    return false;
+}

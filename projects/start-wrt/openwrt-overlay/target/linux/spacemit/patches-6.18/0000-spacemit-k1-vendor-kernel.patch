+
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		port@0 {
+			reg = <0>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			dsi1_output: endpoint@1 {
+				reg = <1>;
+				remote-endpoint = <&lt8911exb_in>;
+			};
+		};
+	};
+
+	edp_panel: panel@0 {
+			status = "ok";
+			// compatible = "spacemit,edp-panel";
+	};
+
+};
+
+&lcds {
+	status = "okay";
+};
+
+&dpu_online2_hdmi {
+	memory-region = <&dpu_resv>;
+	status = "disabled";
+};
+

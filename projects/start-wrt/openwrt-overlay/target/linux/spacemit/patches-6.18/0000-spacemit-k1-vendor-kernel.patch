index 000000000000..8ac65320759a
--- /dev/null
+++ b/drivers/misc/icm42607.c
@@ -0,0 +1,697 @@
+/* drivers/misc/icm42607.c - icm42607  driver
+ *
+ * Copyright (C) 2003-2015 Invensense Corporation.
+ * Author: Mingyang Li <myli@invensense.com>
+ *

+#define GESTURE_RIGHT                        0x21
+#define GESTURE_UP                           0x22
+#define GESTURE_DOWN                         0x23
+#define GESTURE_DOUBLECLICK                  0x24
+#define GESTURE_SINGLECLICK                  0x25

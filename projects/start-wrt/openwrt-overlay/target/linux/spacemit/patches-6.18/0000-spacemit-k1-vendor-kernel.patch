+static int check_led_parameter(char *led)
+{
+	if (!led)
+		return 1;
+
+	if (strlen(led) != 9 || led[4] != '_')
+		return 1;
+	do {
+		if (*led++ == '_')
+			continue;
+		if (!isxdigit(*led++))
+			return 1;
+	} while (*led);
+
+	return 0;
+}

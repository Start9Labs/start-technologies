+static int check_hex(char *temp, int size)
+{
+	int i = 0;
+	unsigned char *ptemp = temp;
+
+	for (i = 0; i < size; i++) {
+		if (ptemp[i] == ':') {
+			i++;
+			continue;
+		}
+		
+		if(!(isxdigit(ptemp[i])))
+			return -FAIL_INVALID_PARAMETER;
+	}
+
+	return 0;

+    if (cts_dev->rtdata.program_mode) {
+        for (i = 0; i < size; i++) {
+            ret = cts_dev_readb(cts_dev, addr + i, data + i, 3, 10);
+            if (ret) {
+                count = snprintf(buf, PAGE_SIZE, "Write hw register error\n");

+static irqreturn_t spacemit_hdmi_irq(int irq, void *dev_id)
+{
+	struct spacemit_hdmi *hdmi = dev_id;
+	hdmi->edid_done = false;
+
+	drm_helper_hpd_irq_event(hdmi->connector.dev);
+
+	return IRQ_HANDLED;
+}

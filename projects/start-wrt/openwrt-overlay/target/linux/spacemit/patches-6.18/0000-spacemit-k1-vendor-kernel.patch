+const char* const mapping_ic_from_type(unsigned char ictype)
+{
+    static char *ic_name = "un-defined";
+
+    switch (ictype)
+    {
+    case 0x00:
+        ic_name = "CHSC5472";
+        break;
+    case 0x01:
+        ic_name = "CHSC5448";
+        break;
+    case 0x02:
+        ic_name = "CHSC5448A";
+        break;
+    case 0x03:
+        ic_name = "CHSC5460";
+        break;
+    case 0x04:
+        ic_name = "CHSC5468";
+        break;
+	case 0x05:
+        ic_name = "CHSC5432";
+        break;
+    case 0x10:
+        ic_name = "CHSC5816";
+        break;
+    case 0x11:
+        ic_name = "CHSC1716";
+        break;
+    default:
+        break;
+    }
+
+    return ic_name;
+}

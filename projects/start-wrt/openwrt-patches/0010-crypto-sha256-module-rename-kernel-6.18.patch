Subject: kmod: crypto-sha256: module renamed sha256_generic -> sha256 in 6.18

Kernel 6.18 renamed the generic sha256 module. kmod-usb-net-rtl8152
depends on this package. NOTE: this change is unconditional and would
break 6.12-kernel targets; we only build the spacemit (6.18) target. A
kernel-version conditional would make it upstreamable.

Start9 downstream patch (start-technologies projects/start-wrt).
Applies to: openwrt v25.12.6

--- a/package/kernel/linux/modules/crypto.mk
+++ b/package/kernel/linux/modules/crypto.mk
@@ -1049,9 +1049,9 @@
 	CONFIG_CRYPTO_SHA2_ARM64_CE \
 	CONFIG_CRYPTO_SHA256_SSSE3
   FILES:= \
-	$(LINUX_DIR)/crypto/sha256_generic.ko \
+	$(LINUX_DIR)/crypto/sha256.ko \
 	$(LINUX_DIR)/lib/crypto/libsha256.ko
-  AUTOLOAD:=$(call AutoLoad,09,sha256_generic)
+  AUTOLOAD:=$(call AutoLoad,09,sha256)
   $(call AddDepends/crypto)
 endef
 

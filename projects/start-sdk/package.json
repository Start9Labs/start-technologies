{
  "name": "@start9labs/start-sdk",
  "version": "3.1.2",
  "description": "Software development kit to facilitate packaging services for StartOS",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "sideEffects": true,
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./esm/lib/index.mjs",
      "default": "./lib/index.js"
    },
    "./lib": {
      "types": "./lib/index.d.ts",
      "import": "./esm/lib/index.mjs",
      "default": "./lib/index.js"
    },
    "./lib/backup": {
      "types": "./lib/backup/index.d.ts",
      "import": "./esm/lib/backup/index.mjs",
      "default": "./lib/backup/index.js"
    },
    "./lib/health/checkFns": {
      "types": "./lib/health/checkFns/index.d.ts",
      "import": "./esm/lib/health/checkFns/index.mjs",
      "default": "./lib/health/checkFns/index.js"
    },
    "./lib/health": {
      "types": "./lib/health/index.d.ts",
      "import": "./esm/lib/health/index.mjs",
      "default": "./lib/health/index.js"
    },
    "./lib/i18n": {
      "types": "./lib/i18n/index.d.ts",
      "import": "./esm/lib/i18n/index.mjs",
      "default": "./lib/i18n/index.js"
    },
    "./lib/mainFn": {
      "types": "./lib/mainFn/index.d.ts",
      "import": "./esm/lib/mainFn/index.mjs",
      "default": "./lib/mainFn/index.js"
    },
    "./lib/primaryUrl": {
      "types": "./lib/primaryUrl/index.d.ts",
      "import": "./esm/lib/primaryUrl/index.mjs",
      "default": "./lib/primaryUrl/index.js"
    },
    "./lib/trigger": {
      "types": "./lib/trigger/index.d.ts",
      "import": "./esm/lib/trigger/index.mjs",
      "default": "./lib/trigger/index.js"
    },
    "./lib/util": {
      "types": "./lib/util/index.d.ts",
      "import": "./esm/lib/util/index.mjs",
      "default": "./lib/util/index.js"
    },
    "./lib/version": {
      "types": "./lib/version/index.d.ts",
      "import": "./esm/lib/version/index.mjs",
      "default": "./lib/version/index.js"
    },
    "./lib/*.js": {
      "types": "./lib/*.d.ts",
      "import": "./esm/lib/*.mjs",
      "default": "./lib/*.js"
    },
    "./lib/*": {
      "types": "./lib/*.d.ts",
      "import": "./esm/lib/*.mjs",
      "default": "./lib/*.js"
    },
    "./*": "./*"
  },
  "typesVersion": {
    ">=3.1": {
      "*": [
        "lib/*"
      ]
    }
  },
  "scripts": {
    "test": "jest -c ./jest.config.js --coverage",
    "buildOutput": "ts-node ./lib/test/makeOutput.ts && npx prettier --write \"**/*.ts\"",
    "check": "tsc --noEmit",
    "tsc": "tsc && tsc -p tsconfig.esm.json && node ../../shared-libs/ts-modules/scripts/esm-extensions.mjs dist/esm"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Start9Labs/start-technologies.git"
  },
  "author": "Start9 Labs",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Start9Labs/start-technologies/issues"
  },
  "homepage": "https://github.com/Start9Labs/start-technologies#readme",
  "dependencies": {
    "@iarna/toml": "^3.0.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@start9labs/start-core": "file:../../shared-libs/ts-modules/start-core/dist",
    "@types/ini": "^4.1.1",
    "@types/node": "^22.19.0",
    "@vercel/ncc": "^0.38.4",
    "deep-equality-data-structures": "^2.0.0",
    "eslint": "^9.39.4",
    "fast-xml-parser": "~5.7.0",
    "ini": "^5.0.0",
    "isomorphic-fetch": "^3.0.0",
    "mime": "^4.1.0",
    "prettier": "3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "yaml": "^2.8.3",
    "zod": "4.6.7"
  },
  "bundleDependencies": [
    "@start9labs/start-core"
  ],
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.0.0",
    "peggy": "^3.0.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.1",
    "ts-pegjs": "^4.2.1",
    "tsx": "^4.21.0"
  }
}

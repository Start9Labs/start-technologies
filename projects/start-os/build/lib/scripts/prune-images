#!/bin/bash

if [ "$UID" -ne 0 ]; then
    >&2 echo 'Must be run as root'
    exit 1
fi

source "$(dirname -- "${BASH_SOURCE[0]}")/os-image-store"
startos_reserve_image_store /media/startos/config || exit

POSITIONAL_ARGS=()

while [[ $# -gt 0 ]]; do
  case $1 in
    -*|--*)
      echo "Unknown option $1"
      exit 1
      ;;
    *)
      POSITIONAL_ARGS+=("$1")
      shift
      ;;
  esac
done

set -- "${POSITIONAL_ARGS[@]}"

needed=$1

if [ -z "$needed" ]; then
    >&2 echo "usage: $0 <SPACE NEEDED>"
    exit 1
fi

startos_prune_images /media/startos "$needed" "${MARGIN:-1073741824}"
#!/bin/bash

set -e

preserve_server_identity() {
    local runtime=$1 persistent=$2 identity_tmp
    [ -f "$runtime" ] || return 0

    openssl pkey -in "$runtime" -check -noout > /dev/null
    identity_tmp=$(mktemp "${persistent}.tmp.XXXXXX")
    # EXIT cleanup outlives function locals.
    trap "$(printf 'rm -f -- %q' "$identity_tmp")" EXIT
    install -m 600 -- "$runtime" "$identity_tmp"
    sync "$identity_tmp"
    mv -fT -- "$identity_tmp" "$persistent"
    sync "$(dirname "$persistent")"
    trap - EXIT
}

if [ "$UID" -ne 0 ]; then
    >&2 echo 'Must be run as root'
    exit 1
fi

if ! [ -f "$1" ]; then
    >&2 echo "usage: $0 <SQUASHFS>"
    exit 1
fi

echo 'Upgrading...'

hash=$(b3sum "$1" | head -c 32)
# A legacy second argument does not enable checksum verification.
if [ -n "${CHECKSUM:-}" ] && [ "$hash" != "$CHECKSUM" ]; then
    >&2 echo "Checksum mismatch: expected $CHECKSUM, got $hash"
    exit 2
fi

SOURCE_DIR=$(dirname -- "${BASH_SOURCE[0]}")
if [ ! -f "$SOURCE_DIR/os-image-store" ] || [ ! -f "$SOURCE_DIR/os-public-source-cache-name" ] || [ ! -f "$SOURCE_DIR/os-public-source-prune-name" ] || ! (
    source "$SOURCE_DIR/os-image-store" && declare -F startos_repack_paths > /dev/null
); then
    unsquashfs -n -f -d / "$1" \
        /usr/lib/startos/scripts/os-image-store \
        /usr/lib/startos/scripts/os-image-lock-name \
        /usr/lib/startos/scripts/os-image-lock-fd-name \
        /usr/lib/startos/scripts/os-public-source-cache-name \
        /usr/lib/startos/scripts/os-public-source-prune-name
fi
source "$SOURCE_DIR/os-image-store"
startos_reserve_image_store /media/startos/config
REPACK_ROOT=$(startos_repack_root /media/startos)
REPACK_UPPER=$(startos_repack_upper /media/startos)

# Must precede boot changes and image activation.
preserve_server_identity /run/startos/id.key.pem /media/startos/config/id.key.pem

unsquashfs -n -f -d / "$1" /usr/lib/startos/scripts/normalize-fstab
if [ -f /media/startos/config/overlay/etc/fstab ]; then
    /usr/lib/startos/scripts/normalize-fstab /media/startos/config/overlay/etc/fstab ||
        >&2 echo 'fstab left unchanged'
fi

unsquashfs -f -d / "$1" boot

umount -l "$REPACK_ROOT" 2> /dev/null || true
umount "$REPACK_UPPER" 2> /dev/null || true
umount /media/startos/lower 2> /dev/null || true

mkdir -p "$REPACK_UPPER"
mount -t tmpfs tmpfs "$REPACK_UPPER"
mkdir -p /media/startos/lower "$REPACK_UPPER/data" "$REPACK_UPPER/work" "$REPACK_ROOT"
mount "$1" /media/startos/lower
mount -t overlay \
      -o "lowerdir=/media/startos/lower,upperdir=$REPACK_UPPER/data,workdir=$REPACK_UPPER/work" \
      overlay "$REPACK_ROOT"

mkdir -p "$REPACK_ROOT/run"
mkdir -p "$REPACK_ROOT/dev"
mkdir -p "$REPACK_ROOT/sys"
mkdir -p "$REPACK_ROOT/proc"
mkdir -p "$REPACK_ROOT/boot"
mkdir -p "$REPACK_ROOT/media/startos/root"
mount --bind /run "$REPACK_ROOT/run"
mount --bind /tmp "$REPACK_ROOT/tmp"
mount --bind /dev "$REPACK_ROOT/dev"
mount -t sysfs sysfs "$REPACK_ROOT/sys"
mount -t proc proc "$REPACK_ROOT/proc"
mount --rbind /boot "$REPACK_ROOT/boot"
mount --bind /media/startos/root "$REPACK_ROOT/media/startos/root"

if mountpoint /sys/firmware/efi/efivars > /dev/null 2>&1; then
    mount -t efivarfs efivarfs "$REPACK_ROOT/sys/firmware/efi/efivars"
fi

chroot "$REPACK_ROOT" bash -e << "EOF"

if [ -f /boot/grub/grub.cfg ]; then
    GRUB_INSTALL_ARGS=()
    if [ -d /sys/firmware/efi ]; then
        GRUB_INSTALL_ARGS+=(--force-extra-removable)
    fi
    grub-install "${GRUB_INSTALL_ARGS[@]}" /dev/$(eval $(lsblk -o MOUNTPOINT,PKNAME -P | grep 'MOUNTPOINT="/media/startos/root"') && echo $PKNAME)
    update-grub
fi

EOF

SIGN_FILE="$(ls -1 "$REPACK_ROOT"/usr/lib/linux-kbuild-*/scripts/sign-file 2>/dev/null | head -1)"
"$REPACK_ROOT/usr/lib/startos/scripts/sign-unsigned-modules" \
    --source /media/startos/lower \
    --dest /media/startos/config/overlay \
    --sign-file "$SIGN_FILE" \
    --mok-key /media/startos/config/overlay/var/lib/dkms/mok.key \
    --mok-pub /media/startos/config/overlay/var/lib/dkms/mok.pub

sync

umount -l "$REPACK_ROOT"
umount "$REPACK_UPPER"
umount /media/startos/lower

mv "$1" "/media/startos/images/${hash}.rootfs"
ln -rsf "/media/startos/images/${hash}.rootfs" /media/startos/config/current.rootfs

sync

echo 'System upgrade complete. Reboot to apply changes...'
#!/bin/bash

set -euo pipefail

legacy=0
if [ "${1:-}" = --legacy ]; then
    legacy=1
    shift
fi
if [ "$#" -gt 1 ]; then
    >&2 echo "Usage: $0 [--legacy] [fstab]"
    exit 1
fi

fstab=$(realpath -- "${1:-/etc/fstab}")
dir=$(dirname -- "$fstab")
tmp=$(mktemp "$dir/.$(basename -- "$fstab").XXXXXX")
trap 'rm -f -- "$tmp"' EXIT

mounted_device() {
    local target=$1 source
    source=$(findmnt -n -o SOURCE --target "$target") || return 1
    source=${source%%\[*}
    [[ $source = /dev/* ]] || return 1
    readlink -f -- "$source"
}

partition_on_disk() {
    local disk=$1 number=$2 output path part found=
    output=$(lsblk -nrpo PATH,PARTN "$disk") || return 1
    while read -r path part; do
        if [ "$part" = "$number" ]; then
            [ -z "$found" ] || return 1
            found=$path
        fi
    done <<< "$output"
    [ -n "$found" ] || return 1
    readlink -f -- "$found"
}

installed_root() {
    if [ "$legacy" -eq 1 ]; then
        mounted_device /
    else
        mounted_device /media/startos/root
    fi
}

installed_device() {
    local target=$1 root parent root_number number device mounted
    root=$(installed_root) || return 1
    parent=$(lsblk -nro PKNAME "$root") || return 1
    root_number=$(lsblk -nro PARTN "$root") || return 1
    [ -n "$parent" ] && [[ $root_number =~ ^[0-9]+$ ]] || return 1

    case "$root_number:$target" in
        4:/) number=4 ;;
        4:/boot) number=3 ;;
        4:/boot/efi) number=2 ;;
        3:/) number=3 ;;
        3:/boot) number=2 ;;
        3:/boot/efi) number=1 ;;
        2:/) number=2 ;;
        2:/boot) number=1 ;;
        *) return 1 ;;
    esac

    device=$(partition_on_disk "/dev/$parent" "$number") || return 1
    if [ "$target" != / ] &&
        ! { [ "$legacy" -eq 1 ] && [ "$target" = /boot/efi ]; }; then
        mounted=$(mounted_device "$target") || return 1
        [ "$mounted" = "$device" ] || return 1
    fi
    printf '%s\n' "$device"
}

partuuid_for_target() {
    local target=$1 device partuuid matches canonical_match
    local -a matching_devices
    device=$(installed_device "$target") || {
        >&2 echo "Unable to establish installed partition for $target"
        return 1
    }
    if ! partuuid=$(blkid -p -s PART_ENTRY_UUID -o value "$device") ||
        [ -z "$partuuid" ] || [[ $partuuid =~ [[:space:]] ]]; then
        >&2 echo "Unable to resolve PARTUUID for installed partition $target"
        return 1
    fi
    if ! matches=$(blkid -t "PARTUUID=$partuuid" -o device); then
        >&2 echo "Unable to uniquely resolve PARTUUID for installed partition $target"
        return 1
    fi
    mapfile -t matching_devices <<< "$matches"
    if [ "${#matching_devices[@]}" -ne 1 ] || [ -z "${matching_devices[0]}" ] ||
        [[ ${matching_devices[0]} =~ [[:space:]] ]]; then
        >&2 echo "Unable to uniquely resolve PARTUUID for installed partition $target"
        return 1
    fi
    canonical_match=$(readlink -f -- "${matching_devices[0]}") || return 1
    if [ "$canonical_match" != "$device" ]; then
        >&2 echo "PARTUUID for installed partition $target resolves to another device"
        return 1
    fi
    printf '%s\n' "$partuuid"
}

declare -A partuuids=()
ends_with_newline=0
if [ -s "$fstab" ] &&
    [ "$(tail -c 1 -- "$fstab" | od -An -t x1 | tr -d '[:space:]')" = 0a ]; then
    ends_with_newline=1
fi

while IFS= read -r line || [ -n "$line" ]; do
    if [[ $line =~ ^([[:blank:]]*)(/dev/[^[:blank:]]+)([[:blank:]]+)([^[:blank:]]+)(.*)$ ]]; then
        leading=${BASH_REMATCH[1]}
        separator=${BASH_REMATCH[3]}
        target=${BASH_REMATCH[4]}
        remainder=${BASH_REMATCH[5]}
        case "$target" in
            /|/boot|/boot/efi)
                if [ -z "${partuuids[$target]:-}" ]; then
                    partuuids[$target]=$(partuuid_for_target "$target") || exit 1
                fi
                printf '%sPARTUUID=%s%s%s%s\n' \
                    "$leading" "${partuuids[$target]}" "$separator" "$target" "$remainder"
                continue
                ;;
        esac
    fi
    printf '%s\n' "$line"
done < "$fstab" > "$tmp"

if [ -s "$fstab" ] && [ "$ends_with_newline" -eq 0 ]; then
    truncate -s -1 "$tmp"
fi

if cmp -- "$fstab" "$tmp" >/dev/null; then
    exit 0
elif [ "$?" -ne 1 ]; then
    exit 1
fi

cp --attributes-only --preserve=mode,ownership,timestamps,xattr -- "$fstab" "$tmp"
sync "$tmp"
mv -f -- "$tmp" "$fstab"
sync "$dir"
trap - EXIT

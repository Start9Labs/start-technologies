#!/bin/bash

SOURCE_DIR="$(dirname $(realpath "${BASH_SOURCE[0]}"))"

# The caller owns the unpublished output and stable source view.
prepare_repack_output() {
    local output=$1 root=$2 configuration=$3 size
    rm -f -- "$output" || return
    if [ -h "$configuration/current.rootfs" ] && [ -e "$configuration/current.rootfs" ]; then
        size=$(du -s --bytes -- "$root") || return
        size=${size%%[[:space:]]*}
        "$SOURCE_DIR/prune-images" "$size" || return
    fi
}

if [ "$UID" -ne 0 ]; then
    >&2 echo 'Must be run as root'
    exit 1
fi

source "$SOURCE_DIR/os-image-store"
startos_reserve_image_store /media/startos/config || exit
REPACK_ROOT=$(startos_repack_root /media/startos) || exit
REPACK_UPPER=$(startos_repack_upper /media/startos) || exit
REPACK_IMAGE=/media/startos/images/next.squashfs

POSITIONAL_ARGS=()

while [[ $# -gt 0 ]]; do
    case $1 in
      --no-sync)
          NO_SYNC=1
          shift
          ;;
      --create)
          ONLY_CREATE=1
          shift
          ;;
      -*|--*)
          echo "Unknown option $1"
          exit 1
          ;;
      *)
          POSITIONAL_ARGS+=("$1")
          shift
          ;;
    esac
done

set -- "${POSITIONAL_ARGS[@]}"

if [ -z "$NO_SYNC" ]; then
    echo 'Syncing...'
    umount -l "$REPACK_ROOT" 2> /dev/null
    umount "$REPACK_UPPER" 2> /dev/null
    rm -rf "$REPACK_UPPER" "$REPACK_ROOT"
    mkdir "$REPACK_UPPER"
    mount -t tmpfs tmpfs "$REPACK_UPPER"
    mkdir -p "$REPACK_UPPER/data" "$REPACK_UPPER/work" "$REPACK_ROOT"
    mount -t overlay \
        -o "lowerdir=/media/startos/current,upperdir=$REPACK_UPPER/data,workdir=$REPACK_UPPER/work" \
        overlay "$REPACK_ROOT"
fi

if [ -n "$ONLY_CREATE" ]; then
    exit 0
fi

mkdir -p "$REPACK_ROOT/run"
mkdir -p "$REPACK_ROOT/dev"
mkdir -p "$REPACK_ROOT/sys"
mkdir -p "$REPACK_ROOT/proc"
mkdir -p "$REPACK_ROOT/boot"
mkdir -p "$REPACK_ROOT/media/startos/root"
mount -t tmpfs tmpfs "$REPACK_ROOT/run"
mount -t tmpfs tmpfs "$REPACK_ROOT/tmp"
mount --bind /dev "$REPACK_ROOT/dev"
mount -t sysfs sysfs "$REPACK_ROOT/sys"
mount -t proc proc "$REPACK_ROOT/proc"
mount --bind /boot "$REPACK_ROOT/boot"
mount --bind /media/startos/root "$REPACK_ROOT/media/startos/root"

if mountpoint /sys/firmware/efi/efivars 2>&1 > /dev/null; then
  mount -t efivarfs efivarfs "$REPACK_ROOT/sys/firmware/efi/efivars"
fi

if [ -z "$*" ]; then
    chroot "$REPACK_ROOT"
    CHROOT_RES=$?
else
    chroot "$REPACK_ROOT" "$SHELL" -c "$*"
    CHROOT_RES=$?
fi

if mountpoint "$REPACK_ROOT/sys/firmware/efi/efivars" 2>&1 > /dev/null; then
  umount "$REPACK_ROOT/sys/firmware/efi/efivars"
fi

umount -l "$REPACK_ROOT/run"
umount -l "$REPACK_ROOT/tmp"
umount -l "$REPACK_ROOT/dev"
umount -l "$REPACK_ROOT/sys"
umount -l "$REPACK_ROOT/proc"
umount -l "$REPACK_ROOT/boot"
umount -l "$REPACK_ROOT/media/startos/root"

if [ "$CHROOT_RES" -eq 0 ]; then

    prepare_repack_output "$REPACK_IMAGE" "$REPACK_ROOT" /media/startos/config || exit

    echo 'Upgrading...'

    if ! time mksquashfs "$REPACK_ROOT" "$REPACK_IMAGE" -b 4096 -comp gzip; then
        umount -l "$REPACK_ROOT"
        umount -l "$REPACK_UPPER"
        rm -rf "$REPACK_UPPER" "$REPACK_ROOT"
        exit 1
    fi
    hash=$(b3sum "$REPACK_IMAGE" | head -c 32)
    mv "$REPACK_IMAGE" /media/startos/images/${hash}.rootfs
    ln -rsf /media/startos/images/${hash}.rootfs /media/startos/config/current.rootfs

    sync

    reboot
fi

umount -l "$REPACK_ROOT"
umount -l "$REPACK_UPPER"
rm -rf "$REPACK_UPPER" "$REPACK_ROOT"
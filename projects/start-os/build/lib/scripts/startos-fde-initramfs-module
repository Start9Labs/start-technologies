. /scripts/local

mount_premount()
{
	:
}

local_mount_root()
{
	local tpm_device=/dev/tpmrm0
	local_top
	[ -n "${ROOT}" ] || panic 'Missing OS volume'
	local_device_setup "${ROOT}" 'OS volume'
	ROOT="${DEV}"
	[ "$(get_fstype "${ROOT}")" = btrfs ] || panic 'Unsupported OS volume'
	local_premount
	mkdir /startos
	mount -t btrfs -o subvolid=5 "${ROOT}" /startos
	# TPM nodes need not have udev database entries.
	udevadm wait --initialized=no --timeout=30 "${tpm_device}" || panic 'TPM2 device unavailable'
	TPM2TOOLS_TCTI="device:${tpm_device}" /usr/bin/startbox start-fde-prepare /startos "${rootmnt}"
}

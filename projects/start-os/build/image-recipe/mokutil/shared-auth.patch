+static int
+refresh_import_auth (const char *pw_hash_file, const int root_pw)
+{
+	pw_crypt_t pw_crypt;
+	size_t size;
+
+	if (efi_get_variable_size (efi_guid_shim, get_req_var_name (ENROLL_MOK),

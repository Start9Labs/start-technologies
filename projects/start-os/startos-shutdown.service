[Unit]
Description=StartOS graceful shutdown
DefaultDependencies=no
# Stop before startd and LXC to finish graceful container teardown.
After=startd.service lxc.service lxc-monitord.service
Before=shutdown.target poweroff.target halt.target
Conflicts=poweroff.target halt.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
# A systemd shutdown transaction cannot wait for a backup.
ExecStop=/usr/bin/start-cli server shutdown --force
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target

lxc.include = /usr/share/lxc/config/common.conf
# userns.conf clears the cap drop/keep lists from common.conf — every
# capability is enabled by default in the service LXC, scoped to its userns.
lxc.include = /usr/share/lxc/config/userns.conf
lxc.arch = linux64

lxc.apparmor.profile = generated
lxc.apparmor.allow_nesting = 1
lxc.idmap = u {id_from} {id_to} {id_count}
lxc.idmap = g {id_from} {id_to} {id_count}

# services.slice bounds aggregate memory use; revocation kills the payload subtree.
lxc.cgroup.dir.monitor = services.slice/monitor/{guid}
lxc.cgroup.dir.container = {payload_cgroup}
lxc.cgroup.dir.container.inner = ns
lxc.rootfs.path = dir:/var/lib/lxc/{guid}/rootfs
lxc.uts.name = {guid}

lxc.net.0.type = veth
lxc.net.0.link = lxcbr0
lxc.net.0.flags = up

lxc.rootfs.options = rshared

lxc.environment = LANG={lang}

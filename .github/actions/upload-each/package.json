  },
  "dependencies": {
    "@actions/artifact": "^6.2.1",
    "@actions/core": "^1.11.1",
    "@actions/glob": "^0.5.0"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.38.3"
  }
}
